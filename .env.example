# Application Environment
APP_ENV=production

# Logging
LOG_LEVEL=INFO

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter Fallback (optional)
# Used automatically ONLY if the Groq call fails.
# Leave OPENROUTER_API_KEY empty to disable the fallback.
# Get a key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# RapidAPI Proxy Secret
# This is the secret shared between RapidAPI and your server.
# DO NOT expose this to end users.
# Get it from: RapidAPI Dashboard > Your API > Settings > Proxy Secret
RAPIDAPI_PROXY_SECRET=your_rapidapi_proxy_secret_here

# Root path (leave empty for normal Coolify deployments at domain root)
ROOT_PATH=

# Reverse Proxy / Coolify / Traefik
FORWARDED_ALLOW_IPS=*
